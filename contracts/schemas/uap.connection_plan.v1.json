  "next_tier": {"enum": ["O0", "O1", "O2", "O3"]}, "next_step": {"type": "string"}, "value": {"type": "number", "minimum": 0, "maximum": 1},
  "cost": {"type": "string"}, "write_path": {"enum": ["None"]}, "rationale": {"type": "string"}}}
